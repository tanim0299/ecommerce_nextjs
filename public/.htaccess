<IfModule mod_headers.c>
  # Enable rich snippet & large image preview for Social Cards (Facebook, WhatsApp, Google)
  Header set X-Robots-Tag "max-image-preview:large, max-snippet:-1"

  # Force browsers & CDN to always fetch latest brand favicons
  <FilesMatch "^(favicon\.(ico|png)|robots\.txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If the requested file or directory exists, serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Dynamic product detail pages fallback to /product/index.html
  RewriteRule ^product/.*$ /product/index.html [L]

  # 3. Dynamic custom pages fallback to /pages/index.html (if exists) or 404.html
  RewriteCond %{DOCUMENT_ROOT}/pages/index.html -f
  RewriteRule ^pages/.*$ /pages/index.html [L]

  # 4. Fallback everything else to root index.html
  RewriteRule ^ index.html [L]
</IfModule>
